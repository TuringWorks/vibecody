{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // No `baseUrl`: TypeScript 6 deprecated it and 7 removed it outright
    // (TS5102). Every mapping below is already relative, and TS resolves
    // `paths` against the tsconfig's own directory when `baseUrl` is absent,
    // so removing it is behaviour-preserving on the pinned 5.x too.
    //
    // Removed pre-emptively: vibedesk hit exactly this the moment its
    // typescript pin moved to ^7, and it only shows up in CI, because a stale
    // local node_modules keeps compiling with the old compiler.
    //
    // This does NOT make the app TS 7-ready. Checked with typescript@7.0.2:
    // the baseUrl error is gone, but CSS side-effect imports then fail with
    // TS2882 ("Cannot find module or type declarations for './App.css'").
    // That needs its own fix when the pin actually moves.
    "paths": {
      "@vibe/shared": [
        "../packages/vibe-ui-shared/src"
      ],
      "@vibe/shared/*": [
        "../packages/vibe-ui-shared/src/*"
      ],
      "react": [
        "./node_modules/@types/react",
        "./node_modules/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*",
        "./node_modules/react/*"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "@tauri-apps/api/*": [
        "./node_modules/@tauri-apps/api/*"
      ],
      "react-markdown": [
        "./node_modules/react-markdown"
      ],
      "remark-gfm": [
        "./node_modules/remark-gfm"
      ]
    }
  },
  "include": [
    "src",
    "../packages/vibe-ui-shared/src"
  ]
}
