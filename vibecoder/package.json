{
  "name": "tauri-app",
  "private": true,
  "version": "0.5.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node ../scripts/tauri.mjs dev",
    "tauri:build": "node ../scripts/tauri.mjs build",
    "test": "vitest run",
    "lint:welcome-layout": "node scripts/check-welcome-layout.mjs",
    "gen:panel-catalog": "node scripts/gen-panel-catalog.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/react": "^12.11.5",
    "dompurify": "^3.4.13",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.35.0",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "y-monaco": "^0.1.6",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
