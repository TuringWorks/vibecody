    "@xyflow/react": "^12.11.2",
    "dompurify": "^3.4.13",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "xterm": "^5.3.0",
