<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WebKit JIT (required: the Tauri webview crashes at startup without this
         under hardened runtime). -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Tauri ships dylibs inside the bundle (libwebkit, plugins). Without
         disabling library validation, the loader rejects them under hardened
         runtime. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- VibeDesk talks to the VibeCLI daemon and to model providers over HTTP.
         network.server is required because, like every desktop shell, it
         autostarts the daemon (see daemon_bootstrap.rs), which binds a local
         port. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- tauri-plugin-dialog file picker needs read-write access to whatever the
         user selects. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Microphone. Under the hardened runtime the audio-input entitlement is
         what actually admits getUserMedia; the Info.plist usage string only
         supplies the text of the consent prompt. Missing either one is a
         silent failure, and they fail differently. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
