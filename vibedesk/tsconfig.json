{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client",
      "node"
    ],
    // No `baseUrl`: TypeScript 7 removed it (TS5102), and every mapping below
    // is already relative — TS resolves `paths` against the tsconfig's own
    // directory when `baseUrl` is absent, so this is behaviour-preserving.
    // package.json pins typescript ^7.0.2, so CI installs a compiler that
    // rejects the option outright while a stale local node_modules on 5.x
    // still accepted it.
    "paths": {
      "@vibe/shared": [
        "../packages/vibe-ui-shared/src"
      ],
      "@vibe/shared/*": [
        "../packages/vibe-ui-shared/src/*"
      ],
      "react": [
        "./node_modules/@types/react",
        "./node_modules/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*",
        "./node_modules/react/*"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "@tauri-apps/api/*": [
        "./node_modules/@tauri-apps/api/*"
      ],
      "react-markdown": [
        "./node_modules/react-markdown"
      ],
      "remark-gfm": [
        "./node_modules/remark-gfm"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../packages/vibe-ui-shared/src"
  ]
}
