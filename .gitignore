# Rust
target/
**/*.rs.bk
*.pdb
*.rlib

# JavaScript/Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# package-lock.json is intentionally COMMITTED: GitHub's dependency graph and
# Dependabot only scan tracked lockfiles. While these were ignored, vibecoder,
# vibeaichat and packages/agent-sdk received zero security alerts despite carrying
# known-vulnerable transitive deps. Committing them also makes builds
# reproducible. Do not re-add package-lock.json here.
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
vscode-extension/out/
*.js.map

# kodegraph CLI output (generated by `kodegraph build <dir>` at repo root)
/kodegraph-out/

# Environment files
.env
.env.local
.env.*.local

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Coverage/Testing
coverage/
.nyc_output/

# Logs
logs/
*.log

# VibeCLI local data (auto-generated, user-specific)
.vibecli/

# Claude Code runtime state (per-session, not for upstream)
.claude/scheduled_tasks.lock

# Local-only working notes (internal triage, not for upstream)
notes/
docs/Gemfile.lock
/jetbrains-plugin/.gradle
/jetbrains-plugin/.intellijPlatform
/jetbrains-plugin/bin
*.class
/vibewatch/VibeCodyWear/.gradle
