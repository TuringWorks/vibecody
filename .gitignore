ollama-launch-codex-app.config.toml

# local one-shot maintenance script (not for publication)
purge-history.sh

# Emitted JS beside the shared TypeScript sources. A stray `thinking.js` here
# takes precedence over `thinking.ts` in Vite's extension resolution, so the app
# silently loads a stale module — an export added later comes back `undefined`
# and the first component to call it blanks the screen. Test scripts must always
# compile with --outDir; this is the backstop.
packages/vibe-ui-shared/src/**/*.js
packages/vibe-ui-shared/src/**/*.d.ts
packages/vibe-ui-shared/src/**/*.js.map

# Python bytecode from the eval fixtures. `evals/fixtures/orders-service` is a
# runnable Python project, so any suite that imports it leaves these behind.
__pycache__/
*.pyc

# Windows installer payload — fetched by scripts/fetch-voice-assets.ps1 and
# staged from a build, never committed: the speech engine is a third-party
# release, the model is 465 MB, and the daemon is a build artifact.
*/src-tauri/resources/whisper/
*/src-tauri/resources/models/
*/src-tauri/binaries/
scripts/.voice-cache/
