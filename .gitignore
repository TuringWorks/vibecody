# Rust
target/
**/*.rs.bk
*.pdb
*.rlib

# JavaScript/Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# package-lock.json is intentionally COMMITTED: GitHub's dependency graph and
# Dependabot only scan tracked lockfiles. While these were ignored, vibecoder,
# vibeapp and packages/agent-sdk received zero security alerts despite carrying
# known-vulnerable transitive deps. Committing them also makes builds
# reproducible. Do not re-add package-lock.json here.
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
vscode-extension/out/
*.js.map

# kodegraph CLI output (generated by `kodegraph build <dir>` at repo root)
/kodegraph-out/

# Environment files
.env
.env.local
.env.*.local

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Coverage/Testing
coverage/
.nyc_output/

